# Wajib
OPENAI_API_KEY=sk-...
# Kosongkan untuk api.openai.com; SumoPod: https://ai.sumopod.com/v1
OPENAI_BASE_URL=https://ai.sumopod.com/v1

# Opsional (nilai default ditampilkan)
# LLM_MODEL=gpt-5-nano               # satu model untuk semua tugas teks
# EMBED_MODEL=text-embedding-3-large # harus sama dengan model pembuat index
# ANSWER_REASONING=low               # tingkat "berpikir" saat menjawab
# HELPER_REASONING=minimal           # tingkat "berpikir" untuk tugas bantu
# TOP_K=10                           # jumlah potongan sumber per jawaban
# APP_PASSWORD=                      # isi agar UI web butuh kata sandi
# DAILY_QUESTION_LIMIT=200           # batas pertanyaan per hari (semua pengguna)
# SESSION_QUESTION_LIMIT=30
