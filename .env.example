OPENAI_API_KEY=sk-...
# Kosongkan untuk api.openai.com; SumoPod: https://ai.sumopod.com/v1
OPENAI_BASE_URL=

# Optional overrides (defaults shown)
# CHAT_MODEL=gpt-5.4-mini            # answers (hemat: gpt-5-nano)
# CHAT_REASONING=low
# FAST_MODEL=gpt-5.4-nano            # query rewrite, rerank (gpt-5-nano butuh FAST_REASONING=minimal)
# FAST_REASONING=none
# CONTEXT_MODEL=gpt-5.4-nano         # contextual retrieval saat `index`; mengganti = bangun ulang semua konteks
# JUDGE_MODEL=gpt-5.4-mini           # golden-set drafting and answer grading
# EMBED_MODEL=text-embedding-3-large # harus sama dengan index
# TOP_K=10                           # chunks given to the answer model
# RERANK_POOL=40
# ANNUAL_REPORT_YEARS=2024,2023
# SUSTAINABILITY_REPORT_LIMIT=1
# CRAWLER_DELAY_S=1.0
