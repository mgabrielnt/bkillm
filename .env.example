# Wajib
OPENAI_API_KEY=sk-...
# Kosongkan untuk api.openai.com; SumoPod: https://ai.sumopod.com/v1
OPENAI_BASE_URL=https://ai.sumopod.com/v1

# Opsional (nilai default ditampilkan)
# CHAT_MODEL=gpt-5-nano              # model jawaban (lebih akurat tapi lebih mahal: gpt-5-mini)
# CHAT_REASONING=low
# FAST_MODEL=gpt-5-nano              # rewrite pertanyaan, rerank
# FAST_REASONING=minimal
# CONTEXT_MODEL=gpt-5-nano           # konteks chunk saat `index` (cache lama tetap dipakai)
# CONTEXT_REASONING=minimal
# JUDGE_MODEL=gpt-5-nano             # pembuat golden set & juri evaluasi
# EMBED_MODEL=text-embedding-3-large # harus sama dengan index
# TOP_K=10                           # jumlah potongan sumber per jawaban
# APP_PASSWORD=                      # isi agar UI web butuh kata sandi
# DAILY_QUESTION_LIMIT=200           # batas pertanyaan per hari (semua pengguna)
# SESSION_QUESTION_LIMIT=30
